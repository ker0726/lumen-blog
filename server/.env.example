# ===== 服务配置 =====
PORT=3001

# ===== 数据源驱动 =====
# mysql（默认）：正式交付路径，需要 MySQL 8
# sqlite：本地联调路径，使用 Node 内置 node:sqlite，零外部依赖
#   - Node 22.x 需以 --experimental-sqlite 启动（如 NODE_OPTIONS=--experimental-sqlite）
#   - Node 24+ 原生支持，无需任何标志
DB_DRIVER=mysql

# ===== MySQL 配置（DB_DRIVER=mysql 时必填）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lumen

# ===== SQLite 配置（DB_DRIVER=sqlite 时生效）=====
SQLITE_FILE=./data/lumen.sqlite

# ===== JWT 配置 =====
# 生产环境务必替换为足够长的随机字符串
JWT_SECRET=lumen_dev_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# ===== 种子数据 =====
# 开发环境下是否插入演示账号（demo@lumen.dev / Demo1234）
SEED_DEMO_USER=true
